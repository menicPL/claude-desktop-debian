#!/usr/bin/env bash
set -euo pipefail

tmp="$(mktemp)"

cleanup() {
	rm -f "$tmp"
}

trap cleanup EXIT

total_rss=0
total_pss=0
for pid in $(pgrep -f '/usr/lib/claude-desktop/node_modules/electron/dist/electron|\.config/Claude/claude-code/.*/claude|cowork-vm-service\.js' || true); do
	[[ -r "/proc/$pid/status" ]] || continue
	rss="$(awk '/^VmRSS:/ {print $2}' "/proc/$pid/status" \
		2>/dev/null || echo 0)"
	pss="$(awk '/^Pss:/ {sum += $2} END {print sum + 0}' \
		"/proc/$pid/smaps_rollup" 2>/dev/null || echo 0)"
	ppid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" \
		2>/dev/null || echo '?')"
	cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null \
		| sed 's/[[:space:]]*$//')"
	total_rss=$((total_rss + rss))
	total_pss=$((total_pss + pss))
	printf '%-8s %-8s %-10s %-10s %s\n' \
		"$pid" "$ppid" "$rss" "$pss" "$cmd" >> "$tmp"
done

printf 'TOTAL_RSS_KB=%s TOTAL_PSS_KB=%s\n' "$total_rss" "$total_pss"
printf '%-8s %-8s %-10s %-10s %s\n' PID PPID RSS_KB PSS_KB CMD
sort -k4,4nr "$tmp"
